    "type": "function",
    "z": "aa11000000000001",
    "name": "brake step (0-8, EB=9)",
    "func": "var cur = flow.get('brake') || 0;\n\nif (msg.payload === 'EB') {\n    cur = 9;\n} else {\n    cur += msg.payload;\n    if (cur < 0) cur = 0;\n    if (cur > 8) cur = 8;\n}\nflow.set('brake', cur);\n\nvar cmd = { payload: { brake: cur } };\nvar disp = { payload: cur };\nreturn [cmd, disp];",
